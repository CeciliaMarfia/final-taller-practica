{a) Modifique el programa anterior para que el mismo robot realice lo mismo en las avenidas 1, 3 y 5.}
programa ejercicio01a
procesos
  proceso juntarFlorEsquina(ES cantFlores:numero; ES cantEsqVacia:numero) 
  comenzar
    si (HayFlorEnLaEsquina)
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        cantFlores:= cantFlores+1
    sino
      cantEsqVacia:= cantEsqVacia+1
  fin
  proceso juntarFlores(ES cantFlores:numero; ES cantEsqVacia:numero)
  comenzar
    repetir 99  
      juntarFlorEsquina(cantFlores, cantEsqVacia) 
      mover  
    juntarFlorEsquina(cantFlores, cantEsqVacia)
  fin
  proceso depositarFlores(E cantFlores:numero)  
  comenzar  
    repetir cantFlores  
      depositarFlor  
  fin 
  proceso recorrerAv(E av:numero)
  variables 
    cantFlores: numero 
    cantEsqVacia: numero 
  comenzar
    cantFlores:= 0 
    cantEsqVacia:= 0 
    juntarFlores(cantFlores, cantEsqVacia) 
    depositarFlores(cantFlores) 
    Informar('cantidad de flores', cantFlores )
    Informar('cantidad de esquinas vacias', cantEsqVacia)
  fin
areas
  area1: AreaP (1,1,1,100)
  area2: AreaP (3,1,3,100)
  area3: AreaP (5,1,5,100)
robots
  robot tipo1
  variables 
    av:numero
  comenzar
    av:=1
    repetir 2
      recorrerAv(av)
      av:= av+2
      Pos(av, 1)
    recorrerAv(av)
  fin
variables
  robot1: tipo1
comenzar
  AsignarArea(robot1, area1)
  AsignarArea(robot1, area2)
  AsignarArea(robot1, area3)
  Iniciar(robot1, 1,1)
fin